    {
      "parameters": {
        "jsCode": "const aiOutput = $input.first().json.output || \"\";\n\n// Limpieza y Seguridad\nlet cleanText = aiOutput\n  .replace(/\\\\n/g, '\\n')      // Saltos de linea reales\n  .replace(/\\*\\*/g, '')       // Sin negritas MD\n  .replace(/^\"|\"$/g, '')      // Sin comillas extra\n  .trim();\n\n// Límite Twitter\nconst MAX = 280;\n\nif (cleanText.length > MAX) {\n  // Estrategia de emergencia: si la IA falló en contar caracteres,\n  // cortamos la \"frase corta\" (línea 2) con elipsis para salvar la estructura.\n  \n  // Separar por líneas\n  let lines = cleanText.split('\\n');\n  \n  // Si tiene la estructura esperada (> 4 líneas)\n  if (lines.length >= 4) {\n     // Intentamos recortar la línea de descripción (índice 1 usualmente)\n     // Recalculamos longitud total quitando esa línea\n     let currentLengthWithoutDesc = cleanText.length - lines[1].length;\n     let availableSpace = MAX - currentLengthWithoutDesc - 3; // -3 para \"...\"\n     \n     if (availableSpace > 10) {\n        lines[1] = lines[1].substring(0, availableSpace) + \"...\";\n        cleanText = lines.join('\\n');\n     }\n  }\n  \n  // Si AÚN así falla (o la estructura no era estándar), corte duro al final.\n  if (cleanText.length > MAX) {\n      cleanText = cleanText.substring(0, MAX - 3) + \"...\";\n  }\n}\n\nreturn {\n  json: {\n    text: cleanText,\n    original_length: aiOutput.length,\n    final_length: cleanText.length\n  }\n};"
      },
